# AquaOps environment template.
#
# Copy to .env, then run `php artisan key:generate`. The values below suit local development.
# See the "Production" block at the bottom for what must change on a host.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=AquaOps
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Shown in the footer and the About panel.
APP_VERSION=0.1.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Reverse proxies whose X-Forwarded-* headers are trusted. Leave empty when PHP is reached directly;
# use * behind a TLS-terminating load balancer, or a comma-separated list of proxy IPs / CIDR ranges.
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The app is developed and run on MySQL. Do not use sqlite outside the test suite: it has no row
# locks, so the lockForUpdate() guards on stock, orders and invoices silently do nothing.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aquaops
DB_USERNAME=root
DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=

# ---------------------------------------------------------------------------
# Sessions, cache, queue
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Send the session cookie over https only. Leave unset locally (http); set to true on a host.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Files
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local
# Disk that holds the uploaded organisation logo. Keep "local" on a single server; use an object
# storage disk (for example s3) when the host's local files do not survive a deploy.
BRANDING_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# "log" writes every email into the log file instead of sending it. That is fine locally, but
# invitation emails contain a temporary password, so never leave it on a host.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Forecasting (ML service under ml/)
# ---------------------------------------------------------------------------
# Base URL of the FastAPI forecast service and how long (seconds) to wait for it.
ML_FORECAST_URL=http://127.0.0.1:8001
ML_FORECAST_TIMEOUT=3
# Shared secret sent to the forecast service. Empty disables it (local development only).
ML_FORECAST_TOKEN=
# Optional link to the Streamlit model dashboard.
ML_DASHBOARD_URL=http://127.0.0.1:8501
# Directory of the served model bundles. Defaults to ml/outputs/saved_models inside the project.
# ML_MODEL_DIR=

# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------
# On a host, change at least the following (set them in the host's environment, not in a committed file):
#
#   APP_ENV=production
#   APP_DEBUG=false                 # true leaks stack traces and environment values
#   APP_URL=https://your-domain     # used for links in emails; https URLs are forced in production
#   LOG_LEVEL=warning               # or info
#   LOG_CHANNEL=stderr              # on containers / platforms that collect stdout and stderr
#   SESSION_SECURE_COOKIE=true
#   TRUSTED_PROXIES=*               # when TLS ends at the host's load balancer or proxy
#   DB_*                            # the host's MySQL credentials
#   MAIL_MAILER=smtp                # or ses / postmark / resend, with its credentials. NOT "log":
#                                   # invitation emails carry a temporary password and would be
#                                   # written to the log file in plain text.
#   MAIL_FROM_ADDRESS=...           # a real sender on your domain
#   ML_FORECAST_URL=https://...     # where the forecast service runs
#   ML_FORECAST_TOKEN=...           # a long random value, the same on the forecast service
#   BRANDING_DISK=s3                # only when local storage is ephemeral (plus the AWS_* keys)
#
# Then run `php artisan key:generate` once (keep APP_KEY stable afterwards), `php artisan migrate --force`
# and `php artisan optimize`, and keep a queue worker and the scheduler running.
